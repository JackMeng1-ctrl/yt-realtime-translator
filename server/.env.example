# Copy this file to .env and fill in your own key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Model for the realtime transcription session
TRANSCRIBE_MODEL=gpt-live-transcribe

# Model that translates each finished sentence
TRANSLATE_MODEL=gpt-6-luna

# On a reasoning model: how much it thinks before answering. Subtitles need
# speed, and translation does not benefit, so none. Raise for a hard language
# pair. Older non-reasoning models ignore this.
TRANSLATE_REASONING_EFFORT=none

# Only for older models. Reasoning models reject temperature, so leave this
# unset unless TRANSLATE_MODEL is one that supports it.
# TRANSLATE_TEMPERATURE=0

# Language the subtitles are translated into
TARGET_LANG=简体中文

PORT=8787

# Speech detection: raise if music or background noise is treated as speech
VAD_RMS_THRESHOLD=500

# Longest a segment can run before it is sent for transcription (ms)
MAX_SEGMENT_MS=7000

# Trailing silence that ends a sentence (ms). Every subtitle waits this long
# before it is even sent off, so it is the largest fixed part of the delay.
# 400 gives noticeably faster subtitles; too low splits sentences at pauses.
END_SILENCE_MS=600

# How many previously shown subtitles to pass to the translator as context,
# so names, terms and pronouns stay consistent. 0 turns context off.
CONTEXT_TURNS=3

# Audio kept from just before speech was detected, so the first syllable of a
# sentence is not clipped (ms)
PRE_ROLL_MS=400
