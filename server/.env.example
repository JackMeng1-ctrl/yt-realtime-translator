# Copy this file to .env and fill in your own key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Model for the realtime transcription session
TRANSCRIBE_MODEL=gpt-live-transcribe

# Model that translates each finished sentence
TRANSLATE_MODEL=gpt-4o

# Language the subtitles are translated into
TARGET_LANG=简体中文

PORT=8787

# Speech detection: raise if music or background noise is treated as speech
VAD_RMS_THRESHOLD=500

# Longest a segment can run before it is sent for transcription (ms)
MAX_SEGMENT_MS=7000
